generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               String           @id @default(cuid())
  username         String           @unique
  email            String?          @unique
  createdAt        DateTime         @default(now())
  followedEntities FollowedEntity[]
  lists            MatchList[]
  ratings          Rating[]
}

model Team {
  id          String  @id @default(cuid())
  externalId  String  @unique
  name        String
  logoUrl     String?
  country     String?
  awayMatches Match[] @relation("AwayTeam")
  homeMatches Match[] @relation("HomeTeam")
}

model Match {
  id          String          @id @default(cuid())
  externalId  String          @unique
  sport       String          @default("football")
  competition String
  season      String?
  matchDate   DateTime
  homeTeamId  String
  awayTeamId  String
  homeScore   Int?
  awayScore   Int?
  statsJson   Json?
  createdAt   DateTime        @default(now())
  awayTeam    Team            @relation("AwayTeam", fields: [awayTeamId], references: [id])
  homeTeam    Team            @relation("HomeTeam", fields: [homeTeamId], references: [id])
  listItems   MatchListItem[]
  ratings     Rating[]

  @@index([matchDate])
}

model Rating {
  id        String   @id @default(cuid())
  userId    String
  matchId   String
  stars     Float
  review    String?
  watchedAt DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tags      String[] @default([])
  match     Match    @relation(fields: [matchId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, matchId])
}

model MatchList {
  id          String          @id @default(cuid())
  userId      String
  title       String
  description String?
  createdAt   DateTime        @default(now())
  user        User            @relation(fields: [userId], references: [id])
  items       MatchListItem[]
}

model MatchListItem {
  id      String    @id @default(cuid())
  listId  String
  matchId String
  order   Int       @default(0)
  list    MatchList @relation(fields: [listId], references: [id])
  match   Match     @relation(fields: [matchId], references: [id])

  @@unique([listId, matchId])
}

model FollowedEntity {
  id         String   @id @default(cuid())
  userId     String
  externalId String
  name       String
  type       String
  logoUrl    String?
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, externalId, type])
}
